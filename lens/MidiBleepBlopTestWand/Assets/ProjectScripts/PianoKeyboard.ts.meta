  InputLines:
    - '// @input AssignableType midi {"hint":"The MidiClientComponent providing the bridge connection."}'
    - '// @input float channel {"hint":"MIDI channel to send on (0-15)"}'
    - '// @input Asset.Material whiteKeyMaterial {"hint":"Material for white keys — color it in the LS material editor. Recommended: Unlit."}'
    - '// @input Asset.Material blackKeyMaterial {"hint":"Material for black keys — color it (black/metallic) in the LS material editor. Recommended: Unlit."}'
    - "// @input SceneObject parentObject {\"hint\":\"Optional. SceneObject to parent keys under (e.g. a ContainerFrame's object). If empty, keys parent under this object.\"}"
    - '// @input Asset.AudioTrackAsset keyDownAudio {"hint":"Optional sound played when a key is pressed"}'
    - '// @input float audioVolume = 0.5 {"hint":"Key-press sound volume, 0..1. Default 0.5 (half = softer)."}'
    - '// @input Asset.Font labelFont {"hint":"Optional font for the key labels"}'
    - '// @input float startNote = 60 {"hint":"Lowest MIDI note (60 = C3; for a bass synth try 36 = C1). Applied at generation — re-stage to change."}'
    - '// @input float octaveShift {"hint":"Shift all keys by whole octaves. +1 = up an octave, -1 = down. Applied at generation — re-stage to change."}'
    - '// @input float keyCount = 13 {"hint":"Number of keys to generate (white + black)"}'
    - '// @input float cc1Controller = -1 {"hint":"CC #1 controller number (0-127). -1 = unused."}'
    - '// @input float cc1Value {"hint":"CC #1 value (0-127)"}'
    - '// @input float cc2Controller = -1 {"hint":"CC #2 controller number (0-127). -1 = unused."}'
    - '// @input float cc2Value {"hint":"CC #2 value (0-127)"}'
    - '// @input float cc3Controller = -1 {"hint":"CC #3 controller number (0-127). -1 = unused."}'
    - '// @input float cc3Value {"hint":"CC #3 value (0-127)"}'
    - '// @input float cc4Controller = -1 {"hint":"CC #4 controller number (0-127). -1 = unused."}'
    - '// @input float cc4Value {"hint":"CC #4 value (0-127)"}'
    - '// @input float velocity = 100 {"hint":"Velocity sent on key press (1-127)"}'
    - // @input float whiteKeyWidth = 2.2
    - // @input float whiteKeyHeight = 9
    - // @input float whiteKeyDepth = 1.5
    - // @input float blackKeyWidth = 1.3
    - // @input float blackKeyHeight = 5.5
    - // @input float blackKeyDepth = 1.8
    - '// @input bool keysMovable {"hint":"If true, adds InteractableManipulation so keys can be grabbed/moved. Default false so pressing plays cleanly."}'
    - '// @input float pressDepth = 0.6 {"hint":"How far a key recedes (cm, into the keyboard) while held — the visible \"depress\"."}'
    - '// @input float pressAnimFactor = 0.35 {"hint":"Depress animation speed, 0..1 per frame (higher = snappier)."}'
    - '// @input float maxHoldSec = 5 {"hint":"Stuck-note safety net: a held note auto-releases after this many seconds if SIK never delivers a release event. 0 disables. Raise it if you want longer intentional holds."}'
    - '// @input Component.Text heldNotesText {"hint":"Optional Text that shows currently-held note names (e.g. \"C3 E3 G3\"). Updates as you play."}'
    - "// @input Component.Text octaveText {\"hint\":\"Optional Text that shows the keyboard's octave + range (e.g. \\\"Octave 3  (C3–C4)\\\"). Set at generation.\"}"
